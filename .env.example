# DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/dynamic_qr_code_pro"

# AUTH
# at least 32 chars, generate with: openssl rand -base64 32
SESSION_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# "1" to send cookies only over HTTPS; leave empty to enable it automatically when BETTER_AUTH_URL is https
COOKIE_SECURE=""

# EMAIL
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
# "1" for implicit TLS (usually port 465), "0" to upgrade with STARTTLS
SMTP_SECURE="0"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Dynamic QR Code Pro <no-reply@example.com>"

# SEO
# public URL of the site, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# QR
# base of the short links encoded in QR codes, e.g. "https://qr.example.com" (it must route /{slug} to /q/{slug});
# leave empty to use "{NEXT_PUBLIC_SITE_URL}/q"
NEXT_PUBLIC_QR_BASE_URL=""
