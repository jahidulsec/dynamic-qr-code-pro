generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String     @id @default(uuid()) @db.VarChar(36)
  name      String     @db.VarChar(255)
  username  String     @unique @db.VarChar(100)
  password  String     @db.VarChar(255)
  role      AdminRoles @default(admin)
  createdAt DateTime   @default(now()) @map("created_at")
  updateAt  DateTime   @updatedAt @map("updated_at")
  QrLink    QrLinks[]

  @@map("admin")
}

model QrLinks {
  id           String   @id @default(nanoid()) @db.VarChar(36)
  name         String   @db.VarChar(255)
  link         String   @db.VarChar(255)
  visitedCount Int?     @default(0) @map("visited_count")
  isTrashed    Boolean? @default(false) @map("is_trashed")
  createdAt    DateTime @default(now()) @map("created_at")
  updateAt     DateTime @updatedAt @map("updated_at")
  adminId      String?  @db.VarChar(36)
  admin        Admin?   @relation(fields: [adminId], references: [id], onUpdate: SetNull)
  qr_tag       qr_tag[]

  @@index([adminId], map: "qr_links_adminId_fkey")
  @@map("qr_links")
}

model qr_tag {
  id         String   @id @db.VarChar(36) @default(uuid())
  qr_id      String?  @db.VarChar(36)
  tag_slug   String?  @db.VarChar(80)
  created_at DateTime @default(now()) @db.Timestamp(0)
  qr_links   QrLinks? @relation(fields: [qr_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "qr_fk")
  tags       tags?    @relation(fields: [tag_slug], references: [slug], onDelete: Cascade, map: "tag_fk")

  @@index([qr_id], map: "qr_fk")
  @@index([tag_slug], map: "tag_fk")
}

model tags {
  slug       String    @id @db.VarChar(80)
  name       String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(0)
  qr_tag     qr_tag[]
}

enum AdminRoles {
  superadmin
  admin
}
